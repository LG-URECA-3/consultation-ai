# 운영 환경용 설정 템플릿
# 복사 후 .env.prod 로 저장하고, 서버/컨테이너에만 배치

# ----------------------------------------
# 1. 환경 구분 (선택, 컨테이너에서 -e 로 넘겨도 됨)
# ----------------------------------------
ENVIRONMENT=production

# ----------------------------------------
# 2. SSM에 없는 값만 여기 넣기 (필수)
# SSM 사용 시 DB/Redis/Kafka/ES는 SSM에서 채워지므로 .env.prod에는 불필요
# ----------------------------------------
OPENAI_API_KEY=
FRIENDLI_TOKEN=

# ----------------------------------------
# 3. SSM 미사용 시에만 사용 (SSM 쓰면 비워두거나 생략)
# ----------------------------------------
# DB_URL=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=consultation_db
ES_URL=
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CONSUMER_GROUP_ID=consultation-group
KAFKA_AUTO_OFFSET_RESET=earliest
REDIS_HOST=
REDIS_PASSWORD=
