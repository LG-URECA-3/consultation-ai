# 운영 환경용 설정 템플릿
# 복사 후 .env.prod 로 저장하고, 서버/컨테이너에만 배치 (git 커밋 금지)

# ----------------------------------------
# 1. 환경 구분 (선택, 컨테이너에서 -e 로 넘겨도 됨)
# ----------------------------------------
ENVIRONMENT=production

# ----------------------------------------
# 2. SSM 사용 시 Parameter Store에 아래 파라미터 등록 (Prefix: /config/consultation-service)
#    필수: db_host, db_port, db_user, db_password, elasticsearch_uris,
#          kafka_bootstrap_servers, openai_api_key, friendli_token
#    선택: db_name, redis_host, redis_password
#    → DATABASE_URL는 앱에서 db_host/db_port/db_user/db_password/db_name 으로 구성
# ----------------------------------------
# OPENAI_API_KEY=
# FRIENDLI_TOKEN=

# ----------------------------------------
# 3. SSM 미사용 시에만 사용 (SSM 쓰면 비워두거나 생략)
# ----------------------------------------
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=consultation_db
# ES_URL=
# KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_CONSUMER_GROUP_ID=consultation-group
# KAFKA_AUTO_OFFSET_RESET=earliest
# REDIS_HOST=
# REDIS_PASSWORD=
